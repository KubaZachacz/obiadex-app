---
import Layout from "../../../layouts/Layout.astro";
import { DishesView } from "../../../components/DishesView";
import { DishEditorOverlay } from "../../../components/DishEditorOverlay";

// Check authentication
const supabase = Astro.locals.supabase;
const {
  data: { session },
} = await supabase.auth.getSession();

if (!session) {
  return Astro.redirect("/login");
}

const { dishId } = Astro.params;

if (!dishId) {
  return Astro.redirect("/dishes");
}
---

<Layout title="Edytuj danie - Obiadex">
  <DishesView client:load />
  <DishEditorOverlay
    mode="edit"
    dishId={dishId}
    isOpen={true}
    onClose={() => {
      // eslint-disable-next-line no-undef
      window.location.href = "/dishes";
    }}
    client:load
  />
</Layout>
