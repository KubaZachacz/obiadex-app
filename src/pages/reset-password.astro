---
import Layout from "@/layouts/Layout.astro";
import AuthPageLayout from "@/components/AuthPageLayout.astro";
import { ResetPasswordForm } from "@/components/ResetPasswordForm";
---

<Layout title="Reset hasła - Obiadex">
  <AuthPageLayout
    title="Resetuj hasło"
    subtitle="Wprowadź swój email aby otrzymać link do resetu hasła"
    secondaryLinks={[
      { href: "/login", label: "Powrót do logowania" },
      { href: "/signup", label: "Nie masz konta? Załóż konto" },
    ]}
  >
    <ResetPasswordForm client:load />
  </AuthPageLayout>
</Layout>
